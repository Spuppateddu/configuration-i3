# Local Claude Code settings (machine-specific)
.claude/
CLAUDE.md

# Editor / OS junk
*.swp
*.swo
*~
.DS_Store
*.bak
*.orig

# Build / runtime artifacts
*.log
/tmp/

# Machine-specific i3 overrides (per-PC display scaling, etc.)
*.local

# Per-PC font sizes, written by best-linux-environment's fonts.local. The GTK one
# is not here: it lives beside the ~/.config symlinks, where GTK resolves it.
size.local.scss
size.local.rasi
size.local.conf
