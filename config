# i3 config file (v4) — https://i3wm.org/docs/userguide.html
# Kept in ~/.i3rc/ and included from ~/.config/i3/config.

# ── Modifier ──────────────────────────────────────────────────────────────
# Window key
#set $mod Mod4
# Alt key
set $mod Mod1

# ── Font ──────────────────────────────────────────────────────────────────
# One family, everywhere: Cascadia Code. Same single family in eww/rofi/dunst/gtk.
font pango:Cascadia Code 10

# ── Autostart ─────────────────────────────────────────────────────────────
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec_always --no-startup-id picom --config ~/.i3rc/picom/picom.conf
# Second -config = this machine's font size (git-ignored, from
# best-linux-environment's fonts.local). Later file wins; a missing one is fine.
exec_always --no-startup-id dunst -config ~/.i3rc/dunst/dunstrc -config ~/.i3rc/dunst/size.local.conf
# Gruvbox dark root window — no wallpaper. Uses feh (not xsetroot): picom
# composites the _XROOTPMAP_ID pixmap, which only feh updates. See the script.
exec_always --no-startup-id ~/.i3rc/scripts/set_background.sh
exec_always --no-startup-id ~/.i3rc/scripts/launch_eww.sh
# Floating desktop: sizes and centres each new window from the live workspace
# rect. Must come after the bar, whose strut is what shrinks that rect.
exec_always --no-startup-id ~/.i3rc/scripts/float.sh watch
# No music daemon here: mpd.socket (systemd, user) starts mpd on the first
# connect, so $mod+m / $mod+Shift+m are what bring it up.

# Hide the mouse pointer while typing.
exec_always --no-startup-id ~/.i3rc/scripts/restart_xbanish.sh

# Keyboard: fast repeat + Caps→Ctrl, reapplied when a keyboard is (re)attached.
exec_always --no-startup-id ~/.i3rc/scripts/restart_kbd.sh

# Put back a border left thick by a crash, or by an i3 restart while the $mod+r
# window mode was on — nothing else would ever restore it.
exec_always --no-startup-id ~/.i3rc/scripts/window_mode.sh clear

# Screensaver stays off, so still no idle lock — xss-lock only fires on suspend.
# DPMS is a separate timer and is on: panel off after 15min. Revert with -dpms.
exec_always --no-startup-id xset s off s noblank +dpms dpms 0 0 900

# ── Audio keys (PipeWire via wpctl) ───────────────────────────────────────
# `-l 1.5` = 50% software boost past unity (ALSA is already at 0.00dB); it clips
# on bass beyond that. scripts/volume.sh repeats the number — change both.
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness keys (if supported).
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Media keys. Browsers only — mpd is off D-Bus since mpDris2 was dropped; drive
# it from ncmpcpp ($mod+m) instead.
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ── Vim-style directions ──────────────────────────────────────────────────
set $up    k
set $down  j
set $left  h
set $right l

floating_modifier $mod
tiling_drag modifier titlebar

# ── Core bindings ─────────────────────────────────────────────────────────
bindsym $mod+Return exec alacritty
bindsym $mod+q kill
bindsym $mod+b exec --no-startup-id firefox --new-window
bindsym $mod+n exec --no-startup-id firefox --private-window

# Coding agent in a terminal. Which one is per-machine and unset here: name it
# with `set $agent claude` in config.local, or the key says nobody is set up.
bindsym $mod+c exec --no-startup-id ~/.i3rc/scripts/agent.sh

# App launcher (rofi drun) and window switcher.
bindsym $mod+d   exec --no-startup-id rofi -show drun -config ~/.i3rc/rofi/config.rasi
bindsym $mod+Tab exec --no-startup-id rofi -show window -config ~/.i3rc/rofi/config.rasi

# Toggle terminal (Alacritty) light/dark colour scheme.
bindsym $mod+Shift+t exec --no-startup-id ~/.i3rc/scripts/theme.sh toggle

# Toggle the top menu bar (eww).
bindsym $mod+Shift+b exec --no-startup-id ~/.i3rc/scripts/toggle_eww.sh

# Screenshot. The last two are one chord: i3 matches the post-modifier keysym,
# which is `4` or `dollar` depending on layout, so both are bound.
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym Control+Shift+4 exec --no-startup-id flameshot gui
bindsym Control+Shift+dollar exec --no-startup-id flameshot gui

# Lock & power menu.
bindsym $mod+Shift+x exec --no-startup-id i3lock
bindsym $mod+Shift+p exec --no-startup-id ~/.i3rc/scripts/powermenu.sh

# Music: full TUI, and a quick rofi folder picker that enqueues + shuffles.
bindsym $mod+m        exec --no-startup-id alacritty -e ncmpcpp
bindsym $mod+Shift+m  exec --no-startup-id ~/.i3rc/scripts/play_folder.sh

# ── Focus ─────────────────────────────────────────────────────────────────
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# ── Move / snap ───────────────────────────────────────────────────────────
# Layout-aware, because i3 can't be: a floating window snaps to half-left /
# standard-centred / full-height / half-right, a tiled one just moves. float.sh.
bindsym $mod+Shift+$left  exec --no-startup-id ~/.i3rc/scripts/float.sh move left
bindsym $mod+Shift+$down  exec --no-startup-id ~/.i3rc/scripts/float.sh move down
bindsym $mod+Shift+$up    exec --no-startup-id ~/.i3rc/scripts/float.sh move up
bindsym $mod+Shift+$right exec --no-startup-id ~/.i3rc/scripts/float.sh move right

# The arrows never snap: on a floating window they nudge it a few pixels, which
# is the only way left to place one off-grid from the keyboard.
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# ── Split / layout ────────────────────────────────────────────────────────
bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Same key, whole desktop: floating desktop <-> plain tiling i3, existing
# windows included. Reloads i3, so the bar blinks once.
bindsym $mod+Control+space exec --no-startup-id ~/.i3rc/scripts/desktop_mode.sh toggle

# ── Scratchpad ────────────────────────────────────────────────────────────
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# ── Workspaces ────────────────────────────────────────────────────────────
bindsym $mod+Control+Right workspace next
bindsym $mod+Control+Left  workspace prev

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# ── Session ───────────────────────────────────────────────────────────────
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This ends your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# ── Resize mode ───────────────────────────────────────────────────────────
mode "resize" {
    bindsym $left  resize shrink width 10 px or 10 ppt
    bindsym $down  resize grow   height 10 px or 10 ppt
    bindsym $up    resize shrink height 10 px or 10 ppt
    bindsym $right resize grow   width 10 px or 10 ppt

    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width 10 px or 10 ppt

    bindsym Return exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
    bindsym Escape exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
    bindsym $mod+r exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
}

# ── Resize mode, floating ─────────────────────────────────────────────────
# Same $mod+r: on a floating window window_mode.sh sends you here instead. hjkl
# squeezes the far edge toward the key, HJKL pushes that same edge back out and
# stops at the workspace, so the window never leaves the monitor. i3 cannot
# clamp, hence a script per keypress; the arrows keep the plain push-out sense.
mode "resize floating" {
    bindsym $left  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink right
    bindsym $down  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink up
    bindsym $up    exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink down
    bindsym $right exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink left

    # The shifted keysym, not Shift+$left: i3 matches what the key produces.
    bindsym Shift+H exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow right
    bindsym Shift+J exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow up
    bindsym Shift+K exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow down
    bindsym Shift+L exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow left

    bindsym Left  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow left
    bindsym Down  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow down
    bindsym Up    exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow up
    bindsym Right exec --no-startup-id ~/.i3rc/scripts/window_mode.sh grow right

    bindsym Shift+Left  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink left
    bindsym Shift+Down  exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink down
    bindsym Shift+Up    exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink up
    bindsym Shift+Right exec --no-startup-id ~/.i3rc/scripts/window_mode.sh shrink right

    bindsym Return exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
    bindsym Escape exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
    bindsym $mod+r exec --no-startup-id ~/.i3rc/scripts/window_mode.sh off
}
bindsym $mod+r exec --no-startup-id ~/.i3rc/scripts/window_mode.sh on

# ── Firefox Picture-in-Picture ────────────────────────────────────────────
# 'sticky' pins the PiP player to the output instead of the workspace that
# spawned it. It only works on floating windows, hence 'floating enable' too.
for_window [class="(?i)firefox" title="^Picture-in-Picture$"] floating enable, sticky enable

# ── Floating desktop (the default here) ───────────────────────────────────
# Every window floats with a real title bar you can grab — i3 as a normal DE,
# not a tiling WM. $mod+Shift+space drops one window back into the tiling layout.

# The default, not the only mode: $mod+Control+space writes 90-tiling-mode.local,
# whose rules run after this one and tile everything back. See desktop_mode.sh.

# One rule, not two: a separate [floating] rule would only match on the next
# manage pass. Placement is float.sh's alone — a `move position center` here
# also fires on a *managed* window whenever i3 re-arms the rule (any reload,
# then that window's next title change), which flings it back to the middle.
# 3px, not the more usual 2: the border *is* the mouse resize handle, and two
# pixels of it is a target you miss more often than you hit — corners worst.
for_window [class=".*"] floating enable, border normal 3

# `border normal 3` above also puts back the border Alacritty drops via
# _MOTIF_WM_HINTS. These two cover windows floated or tiled after the fact.
default_floating_border normal 3
default_border          pixel 3

# Click to focus. Focus-follows-mouse fights overlapping windows: the pointer
# resting over a background one steals focus from the window you are typing in.
focus_follows_mouse no

# Minimise-ish — i3 has none, the scratchpad is the closest thing. Super is
# otherwise unbound ($mod is Alt); $mod+minus brings stashed windows back.
bindsym Mod4+Down move scratchpad

# ── Look: gaps, borders, colors (Gruvbox Dark) ────────────────────────────
# 'none' keeps the focused border visible even when a single window fills the screen
hide_edge_borders none

gaps inner 0
gaps outer 0
smart_gaps on

# class                 border    backgr.   text      indicator child_border
client.focused          #d3869b   #d3869b   #282828   #d3869b   #d3869b
client.focused_inactive #3c3836   #3c3836   #a89984   #504945   #3c3836
client.unfocused        #282828   #282828   #a89984   #504945   #282828
client.urgent           #fb4934   #fb4934   #282828   #fb4934   #fb4934
client.placeholder      #282828   #282828   #ebdbb2   #282828   #282828
client.background       #282828

# ── No built-in i3bar — the eww bar is launched by launch_eww.sh ─────────

# ── Machine-specific overrides (git-ignored, not shared across PCs) ──────
# Per-computer settings go in ~/.i3rc/config.local (see README); loaded last so
# it overrides anything above, and a no-op where no such file exists.
include ~/.i3rc/*.local
