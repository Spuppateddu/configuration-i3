/* Compact power menu theme */

* {
    base:     #282828;
    text:     #ebdbb2;
    surface0: #3c3836;
    lavender: #fe8019;
    blue:     #83a598;
    /* i3's focused and unfocused colours; focus.local.rasi overrides these. */
    accent:       @blue;
    on-accent:    @base;
    second:       #00000000;
    on-second:    @blue;
    /* Same single family as ../config. */
    font: "Cascadia Code NF 11";
}

window {
    location:         center;
    width:            260px;
    border:           2px;
    border-radius:    14px;
    border-color:     @accent;
    background-color: @base;
}

mainbox {
    padding:          14px;
    spacing:          10px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @surface0;
    children:         [ "prompt" ];
}

prompt {
    padding:          0 6px;
    border-radius:    6px;
    background-color: @second;
    text-color:       @on-second;
}

entry { enabled: false; }

listview {
    columns: 1; lines: 5; scrollbar: false; spacing: 4px;
    background-color: transparent;
}

element {
    padding:          8px 12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @text;
    cursor:           pointer;
}

element selected.normal { background-color: @accent; text-color: @on-accent; }

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/* This machine's font size (git-ignored, from best-linux-environment's
   fonts.local). Last, so it wins; rofi skips it quietly when it is absent. */
@import "~/.i3rc/rofi/size.local.rasi"
/* i3's focused colours (git-ignored, from best-linux-environment's settings.local). */
@import "~/.i3rc/rofi/focus.local.rasi"
